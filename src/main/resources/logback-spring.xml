<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="LOGS" source="modules.logging.logs.folder.path" defaultValue="./logs"/>
    <springProperty scope="context" name="appName" source="modules.logging.application.name" defaultValue="UNKNOWN"/>
    <property name="LOG_LEVEL_PATTERN" value="%-5level"/>

    <!-- Shared by every profile. On Lambda, stdout is shipped to the function's
         log group (SpringBoot_Lambda_Function_Logs) automatically. -->
    <appender name="Console"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} | ${appName} | %-20.20thread | ${LOG_LEVEL_PATTERN} |
                %-25.25logger{25} | %m%n
            </Pattern>
        </encoder>
    </appender>

    <!-- ============================================================
         AWS Lambda (SPRING_PROFILES_ACTIVE=lambda)
         Console only: the filesystem is read-only (except /tmp) and Lambda
         already forwards stdout to CloudWatch. No background threads or
         extra AWS API calls during init, which keeps SnapStart happy.
         ============================================================ -->
    <springProfile name="lambda">
        <root level="INFO">
            <appender-ref ref="Console"/>
        </root>

        <logger name="com.ce" level="INFO" additivity="false">
            <appender-ref ref="Console"/>
        </logger>
    </springProfile>

    <!-- ============================================================
         Everything else (local development, tests, ...)
         Appenders are defined inside the profile because Logback starts every
         appender it parses, even ones nothing references.
         ============================================================ -->
    <springProfile name="!lambda">

        <appender name="RollingFile"
                  class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOGS}/${appName}.log</file>
            <encoder
                    class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <Pattern>%d %p %c{1} [%t] %m%n</Pattern>
            </encoder>

            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOGS}/archived/${appName}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
        </appender>

        <appender name="CLOUDWATCH" class="com.kdgregory.logback.aws.CloudWatchAppender">
            <logGroup>SpringBoot_Lambda_APIGateway_DynamoDB_Logs</logGroup>
            <logStream>instance</logStream>
            <layout class="ch.qos.logback.classic.PatternLayout">
                <Pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} | ${appName} | %-20.20thread | ${LOG_LEVEL_PATTERN} |
                    %-25.25logger{25} | %m%n
                </Pattern>
            </layout>
        </appender>

        <!-- LOG everything at INFO level -->
        <root level="INFO">
            <appender-ref ref="RollingFile"/>
            <appender-ref ref="Console"/>
            <appender-ref ref="CLOUDWATCH"/>
        </root>

        <!-- LOG "com.ce*" at TRACE level -->
        <logger name="com.ce" level="TRACE" additivity="false">
            <appender-ref ref="RollingFile"/>
            <appender-ref ref="Console"/>
            <appender-ref ref="CLOUDWATCH"/>
        </logger>

    </springProfile>

</configuration>